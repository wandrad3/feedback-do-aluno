{
  "info": {
    "name": "FACULDADE DO ALUNO | Feedback do Aluno",
    "description": "Testes da API implantada na conta AWS 315205584370, região us-east-2. Preencha usuario, senha e email_professor nas variáveis locais. Execute 01 para obter o AccessToken antes das rotas protegidas. 03 e 04 criam avaliações fictícias; 04 envia um alerta real. 07 solicita a verificação SES do e-mail informado; confirme o link da AWS antes de esperar mensagens. 08 aciona o relatório da semana anterior em HTML preto e branco, com período, média, contagens e detalhes das avaliações; HTTP 202 indica processamento, não entrega na caixa de entrada. 09 remove o cadastro do professor. Não exporte a collection após preencher credenciais ou token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://vilam86911.execute-api.us-east-2.amazonaws.com" },
    { "key": "cognito_url", "value": "https://cognito-idp.us-east-2.amazonaws.com/" },
    { "key": "client_id", "value": "7l8o6012lm01h37ositatnsn36" },
    { "key": "usuario", "value": "" },
    { "key": "senha", "value": "" },
    { "key": "email_professor", "value": "" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Autenticar no Cognito",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Autenticação HTTP 200', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) {",
            "  const result = pm.response.json();",
            "  pm.test('AccessToken presente', function () { pm.expect(result.AuthenticationResult.AccessToken).to.be.a('string').and.not.empty; });",
            "  pm.collectionVariables.set('access_token', result.AuthenticationResult.AccessToken);",
            "}"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-amz-json-1.1" },
          { "key": "X-Amz-Target", "value": "AWSCognitoIdentityProviderService.InitiateAuth" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"AuthFlow\":\"USER_PASSWORD_AUTH\",\"ClientId\":\"{{client_id}}\",\"AuthParameters\":{\"USERNAME\":\"{{usuario}}\",\"PASSWORD\":\"{{senha}}\"}}"
        },
        "url": "{{cognito_url}}"
      }
    },
    {
      "name": "02 - Consultar OpenAPI",
      "request": { "method": "GET", "url": "{{base_url}}/openapi.json" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('OpenAPI HTTP 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Contrato OpenAPI 3', function () { pm.expect(pm.response.json().openapi).to.match(/^3\\./); });"
      ] } }]
    },
    {
      "name": "03 - Avaliação normal",
      "request": {
        "method": "POST",
        "description": "Use um usuário Cognito com token válido. A avaliação fica registrada e entra no próximo relatório da semana correspondente.",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"descricao\":\"Aula de teste clara e objetiva\",\"nota\":9}" },
        "url": "{{base_url}}/avaliacao"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Criada HTTP 201', function () { pm.response.to.have.status(201); });",
        "pm.test('Urgência normal e ID presentes', function () { const body = pm.response.json(); pm.expect(body.urgencia).to.eql('NORMAL'); pm.expect(body.id).to.be.a('string').and.not.empty; });"
      ] } }]
    },
    {
      "name": "04 - Avaliação crítica (envia alerta ao administrador)",
      "request": {
        "method": "POST",
        "description": "Cria um registro fictício com nota 2 e envia um alerta real aos destinatários SES verificados. Use conscientemente.",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"descricao\":\"Aula fictícia para validar alerta\",\"nota\":2}" },
        "url": "{{base_url}}/avaliacao"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Criada HTTP 201', function () { pm.response.to.have.status(201); });",
        "pm.test('Urgência crítica', function () { pm.expect(pm.response.json().urgencia).to.eql('CRITICA'); });"
      ] } }]
    },
    {
      "name": "05 - Nota inválida",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"descricao\":\"Teste de validação\",\"nota\":11}" },
        "url": "{{base_url}}/avaliacao"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Rejeitada HTTP 400', function () { pm.response.to.have.status(400); });",
        "pm.test('Mensagem de erro presente', function () { pm.expect(pm.response.json().erro).to.be.a('string'); });"
      ] } }]
    },
    {
      "name": "06 - Sem token",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"descricao\":\"Teste sem autenticação\",\"nota\":9}" },
        "url": "{{base_url}}/avaliacao"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Acesso negado HTTP 401', function () { pm.response.to.have.status(401); });"
      ] } }]
    },
    {
      "name": "07 - Cadastrar e-mail do professor",
      "request": {
        "method": "POST",
        "description": "Exige usuário do grupo Professores. Preencha email_professor com um endereço que você controla e confirme o link enviado pelo SES. Em sandbox, só endereços verificados recebem alertas e relatórios.",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email_professor}}\"}" },
        "url": "{{base_url}}/professores/email"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Cadastro aguardando verificação HTTP 202', function () { pm.response.to.have.status(202); });",
        "pm.test('Orientação de verificação presente', function () { pm.expect(pm.response.json().mensagem).to.include('Verifique seu e-mail'); });"
      ] } }]
    },
    {
      "name": "08 - Solicitar relatório semanal",
      "request": {
        "method": "POST",
        "description": "Exige usuário do grupo Professores. Solicita de forma assíncrona o relatório da semana ISO anterior, no horário de São Paulo. O e-mail FACULDADE DO ALUNO informa período, total, média, críticas e normais, volume por dia e por nota e detalhes de cada avaliação. A resposta 202 confirma a solicitação; confira o recebimento no endereço SES verificado.",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "url": "{{base_url}}/relatorio/solicitar"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Envio solicitado HTTP 202', function () { pm.response.to.have.status(202); });",
        "pm.test('Processamento assíncrono informado', function () { pm.expect(pm.response.json().mensagem).to.include('em processamento'); });"
      ] } }]
    },
    {
      "name": "09 - Remover e-mail do professor",
      "request": {
        "method": "DELETE",
        "description": "Remove apenas o e-mail associado ao professor autenticado. Execute após testar o cadastro e o relatório se não quiser continuar recebendo mensagens.",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "url": "{{base_url}}/professores/email"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Cadastro removido HTTP 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Remoção confirmada', function () { pm.expect(pm.response.json().mensagem).to.eql('Cadastro removido'); });"
      ] } }]
    }
  ]
}
